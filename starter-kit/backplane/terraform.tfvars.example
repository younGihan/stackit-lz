# Copy to terraform.tfvars (or pass via -var-file / -var) and fill in real values.

workspace_identifier = "my-platform-team-workspace"

# Push this repo somewhere meshStack can clone it, then point these at it.
bbd_repository_url  = "https://github.com/my-org/stackit-lz.git"
bbd_repository_path = "buildingblock/starter-kit"
bbd_ref_name         = "main"
bbd_draft            = true

# From `terraform output building_block_definition_version_uuid` in
# ../../stackit-project-creation/backplane, after applying it.
stackit_project_creation_bb_version_uuid = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
