# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json
!*.tfvars.example

# Ignore override files, generally used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI-generated config files
generated_resources.tf
